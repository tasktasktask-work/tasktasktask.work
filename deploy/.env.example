# VPS のプロジェクトディレクトリに .env として置く。
# リポジトリには入れない。

# GitHub Actions の Deploy ワークフローが push したイメージ。
# ワークフローの DOCKER_REGISTRY_HOST と同じものを指す。
APP_IMAGE=REGISTRY_HOST/tasktasktask.work:latest

# 画面に出すURLと、メールに入れるリンクの起点。
# Cloudflare が SSL を終端するため、ここは https で書く。
APP_ORIGIN=https://tasktasktask.work

# 既に動いている postgres へ、postgres-network 越しに繋ぐ。
DATABASE_URL=postgres://task3:PASSWORD@postgres:5432/task3?sslmode=disable

# メール送信。Cloudflare Email Service の SMTP を使う。
#
# console にすると、通知もマジックリンクも標準出力に書かれるだけで誰にも届かない。
# 通知メールは app の中で 60 秒ごとに回る巡回が送るので、cron の設定は要らない。
MAIL_TRANSPORT=smtp
SMTP_URL=smtps://USER:PASSWORD@smtp.mx.cloudflare.net:465

# 受信箱は用意していない。返信できない旨は本文の末尾に書いてある。
MAIL_FROM=TASK3 <noreply@tasktasktask.work>

# 課金。stripe にすると、おためし期間の切れた組織が凍結される。
#
# 前月ぶんの請求は app の中で 5 分ごとに回る巡回が確定させるので、
# cron の設定は要らない。通知メールと同じく、app を二つに増やせない理由が
# もう一つ増えることになる。
#
# off にすると判定そのものを行わず、すべての組織が書き込める。
BILLING_MODE=stripe

# Stripe の秘密鍵。ダッシュボードの「開発者 > API キー」。
#
# 決済は USD で行う。金額はセントの整数で渡す（100 が $1.00）。
# 税額の計算は Stripe に任せない。適格請求書発行事業者の登録をしていないので、
# 税を別記した請求書を出さない。単価そのものが税込である。
STRIPE_SECRET_KEY=sk_live_REPLACE_ME

# Webhook の署名の秘密。
#
# 送り先は https://tasktasktask.work/api/stripe/webhook で、
# 受けるのは invoice.paid と invoice.payment_failed の二つだけでよい。
#
# 自動再試行（Smart Retries）を探して切る必要は無い。
# 請求書を auto_advance=false で作り、決済はこちらから一度だけ呼ぶので、
# Stripe が次の試行を予約する経路に入らない。
# その設定はサブスクリプション向けで、この実装は使っていない。
#
# 確かめたいときは、テストカード 4000 0000 0000 0341 で一度失敗させ、
# ダッシュボードでその請求書の「次回の支払い試行日」が空欄であることを見る。
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
