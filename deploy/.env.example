# VPS のプロジェクトディレクトリに .env として置く。
# リポジトリには入れない。

# GitHub Actions の Deploy ワークフローが push したイメージ。
# ワークフローの DOCKER_REGISTRY_HOST と同じものを指す。
APP_IMAGE=REGISTRY_HOST/tasktasktask.work:latest

# 画面に出すURLと、メールに入れるリンクの起点。
# Cloudflare が SSL を終端するため、ここは https で書く。
APP_ORIGIN=https://tasktasktask.work

# 既に動いている postgres へ、postgres-network 越しに繋ぐ。
DATABASE_URL=postgres://task3:PASSWORD@postgres:5432/task3?sslmode=disable

# メール送信。Cloudflare Email Service の SMTP を使う。
#
# console にすると、通知もマジックリンクも標準出力に書かれるだけで誰にも届かない。
# 通知メールは app の中で 60 秒ごとに回る巡回が送るので、cron の設定は要らない。
MAIL_TRANSPORT=smtp
SMTP_URL=smtps://USER:PASSWORD@smtp.mx.cloudflare.net:465

# 受信箱は用意していない。返信できない旨は本文の末尾に書いてある。
MAIL_FROM=TASK3 <noreply@tasktasktask.work>
