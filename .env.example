# 開発用。手元で .env として写して使う。
# 本番のものは deploy/.env.example にある。

APP_ORIGIN="http://localhost:3000"

# 開発用のデータベース
DATABASE_URL="postgres://postgres:postgres@localhost-postgresql:5432/tasktasktask_work_local?sslmode=disable"

# Atlas が差分計算に使う作業用データベース。
#
# 実行のたびに Atlas が中身を作り直す。
# DATABASE_URL と同じものを指すと、開発用のデータが消える。
# Docker があるなら docker://postgres/18/dev?search_path=public でもよい。
ATLAS_DEV_URL="postgres://postgres:postgres@localhost-postgresql:5432/tasktasktask_work_atlas?search_path=public&sslmode=disable"

# メール送信。開発中は console を指定し、標準出力へ書き出す。
MAIL_TRANSPORT="console"
MAIL_FROM="TASK3 <noreply@tasktasktask.work>"

# 添付ファイルの保存先
ATTACHMENTS_DIR="/workspace/.data/attachments"
